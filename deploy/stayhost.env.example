# Template for ~/deploy/stayhost.env on the deploy host.
# Copy it, fill in a real password, and `chmod 600` the result. Never commit the copy.
#
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 32

POSTGRES_DB=stayhost
POSTGRES_USER=stayhost
POSTGRES_PASSWORD=change-me

# The CI deploy job overrides this with the exact commit tag; the value here is what
# a manual `docker compose up -d` falls back to.
STAYHOST_IMAGE=ghcr.io/minhhung19872002/stayhost:latest

# Outgoing mail (docs/08 §3, docs/01 TK-01). Leave EMAIL_HOST empty and nothing is
# sent: the queue simply holds every message. That is safe for a demo, but it also
# means the six-digit code an admin needs to sign in never arrives — read it out of
# the queue instead:
#
#   docker exec stayhost-db psql -U stayhost -d stayhost -t -A \
#     -c "select \"Body\" from email_messages order by \"Id\" desc limit 1;"
#
# Port 587 starts plain and upgrades; set EMAIL_IMPLICIT_TLS=true for port 465.
#
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER is the full address,
# and EMAIL_PASSWORD is a 16-character App Password from
# myaccount.google.com/apppasswords — the account password itself will not work,
# and the account needs two-step verification switched on before that page appears.
# EMAIL_FROM must be the same address Gmail authenticated, or it rewrites the sender.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@stayhost.vn
EMAIL_FROM_NAME=StayHost
EMAIL_IMPLICIT_TLS=false

# The console account is seeded as admin@stayhost.vn — a domain nobody owns, so the
# sign-in code of docs/08 §3 goes somewhere unreadable. Put a real address here and
# the account moves to it on the next start; that address is then what you sign in
# with. Leave it empty to keep admin@stayhost.vn.
ADMIN_EMAIL=
