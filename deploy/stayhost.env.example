# Template for ~/deploy/stayhost.env on the deploy host.
# Copy it, fill in a real password, and `chmod 600` the result. Never commit the copy.
#
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 32

POSTGRES_DB=stayhost
POSTGRES_USER=stayhost
POSTGRES_PASSWORD=change-me

# What a `docker compose up -d` run by hand deploys — the CI job passes the commit
# tag in the environment and never reads this line, so this is the operator's copy.
# CI rewrites it after every healthy deploy, which is what keeps it honest: it then
# names the image actually running, so a hand-run deploy reproduces the live state
# instead of quietly rolling production back to an older commit.
#
# The :latest below is only the value a brand-new host starts at, before the first
# deploy writes over it. Nothing pulls :latest onto the box (CI ships sha-<commit>
# tags) and the box holds no GHCR credentials of its own, so until that first deploy
# lands, a manual `up -d` fails at the pull with `denied`.
STAYHOST_IMAGE=ghcr.io/minhhung19872002/stayhost:latest

# Outgoing mail (docs/08 §3, docs/01 TK-01). Leave EMAIL_HOST empty and nothing is
# sent: the queue simply holds every message. That is safe for a demo, but it also
# means the six-digit code an admin needs to sign in never arrives — read it out of
# the queue instead:
#
#   docker exec stayhost-db psql -U stayhost -d stayhost -t -A \
#     -c "select \"Body\" from email_messages order by \"Id\" desc limit 1;"
#
# Port 587 starts plain and upgrades; set EMAIL_IMPLICIT_TLS=true for port 465.
#
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER is the full address,
# and EMAIL_PASSWORD is a 16-character App Password from
# myaccount.google.com/apppasswords — the account password itself will not work,
# and the account needs two-step verification switched on before that page appears.
# EMAIL_FROM must be the same address Gmail authenticated, or it rewrites the sender.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@staylio.vn
EMAIL_FROM_NAME=StayHost
EMAIL_IMPLICIT_TLS=false

# The console account is seeded as admin@staylio.vn. That address only receives the
# sign-in code of docs/08 §3 if a mailbox actually exists behind it — owning the
# domain is not the same as having the inbox. Put a real address here and
# the account moves to it on the next start; that address is then what you sign in
# with. Leave it empty to keep admin@staylio.vn.
ADMIN_EMAIL=

# docs/08 §3 bắt buộc quản trị có bảo mật 2 lớp và nói rõ "không có ngoại lệ". Đặt
# false là tự tay mở một lỗ trên tường: mật khẩu quản trị trở thành thứ duy nhất
# chặn người lạ đọc giấy tờ tuỳ thân, khoá tài khoản, hoàn tiền. Chỉ dùng khi máy
# chủ chưa gửi được email, và **đừng để lộ mật khẩu quản trị ở đâu công khai**
# trong lúc nó đang tắt. Bật lại ngay khi EMAIL_HOST chạy.
ADMIN_REQUIRE_2FA=true

# docs/01 TK-02 — "Tiếp tục với Google / Apple / Facebook" trên hộp đăng nhập. Nhà
# cung cấp nào để trống thì nút của nó không hiện, nên bỏ trống cả khối là một cấu
# hình chạy được, không phải hỏng. Điền vào là nút hiện ngay ở lần khởi động sau,
# không phải build lại image.
#
# Đăng nhập bằng nhà cung cấp cũng chính là ĐĂNG KÝ: lần đầu ai đó bấm nút, máy chủ
# tạo tài khoản mới từ danh tính đã ký. Chỉ ghép vào tài khoản email sẵn có khi
# email đó đã được sàn xác thực trước.
#
# Google (miễn phí): console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID → Web application. Trong "Authorised JavaScript origins"
# khai địa chỉ prod, không có dấu / ở cuối:
#     https://staylio.vn
# Không cần "Authorised redirect URIs" — nút Google chạy bằng token ngay trong
# trang, không chuyển hướng đi đâu.
#
# Google chặn theo origin của TRANG đang bấm nút, nên muốn thử nút này trên máy
# lập trình thì khai thêm origin của máy đó. Hai kiểu chạy có hai cổng khác nhau:
#     http://localhost:5199    # dotnet run, phục vụ bản đã build
#     http://localhost:5273    # npm run dev, vite tự phục vụ trang
# Thiếu dòng tương ứng thì nút báo origin_mismatch. Không chạy máy cục bộ thì bỏ
# cả hai, prod không bị ảnh hưởng.
GOOGLE_CLIENT_ID=
#
# Apple (cần tài khoản Apple Developer trả phí 99 USD/năm): developer.apple.com →
# Identifiers → Services ID. APPLE_REDIRECT_URI phải trùng Return URL đã khai
# TỪNG KÝ TỰ, kể cả https và dấu / cuối, nếu không Apple từ chối thẳng.
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=
#
# Facebook: developers.facebook.com → App → Facebook Login for Web. App secret là
# bí mật thật — nó ở đây, trong file chmod 600, chứ không vào appsettings.json.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
#
# --- Dịch tự động (docs/01 TĐ-03, TN-06) ------------------------------------
# Mặc định BẬT, dùng container LibreTranslate tự host (miễn phí, không giới hạn,
# không cần khoá). Để mặc định thì bỏ trống cả khối này. Chỉ đặt khi muốn đổi:
#   - Tắt dịch:            TRANSLATION_PROVIDER=            (để trống)
#   - Bớt ngôn ngữ (RAM):  TRANSLATE_LANGS=en,vi
#   - Đổi sang Google:     TRANSLATION_PROVIDER=google + TRANSLATION_API_KEY=<khoá>
TRANSLATION_PROVIDER=
TRANSLATE_LANGS=
TRANSLATION_API_KEY=
